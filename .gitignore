# Dependencies
node_modules/

# Build output
dist/

# Large immutable evidence & DCC sources (kept on disk, never committed)
evidence/
backup/
asset-pack/
3D资产/
*.zip

# Large runtime GLB packages (canonical copies live under evidence/ with frozen SHA-256)
public/assets/**/*.glb
public/assets/feiyun-runtime/
public/assets/tengwang-high-precision/
public/assets/scene-pack/

# 流程性产物：调研与过程文档（本地留存，不进仓库）
references/
docs/CONTINUATION-*.md
docs/CURRENT-STATUS.md
docs/engineering-implementation-*.md
docs/BLENDER_REBUILD_PLAN.md
docs/CHINA_TOWER_SOURCE_REBUILD_NOTES.md
docs/isolated-max-conversion-sop.md

# 流程性产物：DCC 资产处理管道（Blender/3ds Max 过程脚本，含本机路径与机器配置；本地留存不进仓库）
pipeline/
schemas/

# scripts/ 白名单：只进成品链路所需（拉资产/打包/构建/部署/截图），其余过程脚本本地留存
scripts/*
!scripts/fetch-assets.mjs
!scripts/package-asset-pack.mjs
!scripts/deploy-static.mjs
!scripts/build-final-html.mjs
!scripts/verify-final-html.mjs
!scripts/shot-screenshots.mjs

# Editor / temp backups
*.bak.*
*.tmp

# Python cache (pipeline tooling)
__pycache__/
*.pyc
.workbuddy/
.workbuddy-ai/
.zcode/
.tmp-drt/

# 流程性产物：调研参考纹理（运行时零引用，本地留存不进仓库）
huanghe_textures/
penglai_textures/
tengwang_textures/
