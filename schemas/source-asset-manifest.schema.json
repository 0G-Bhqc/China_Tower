{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.china-tower/schemas/source-asset-manifest.schema.json",
  "title": "SourceAssetManifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "assetId",
    "nameCN",
    "generatedAt",
    "source",
    "companions",
    "sceneMetadata",
    "security"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assetId": { "enum": ["yueyang", "huanghe", "tengwang", "feiyun", "penglai"] },
    "nameCN": { "type": "string", "minLength": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/fileRecord" },
    "companions": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/fileRecord" },
          {
            "type": "object",
            "properties": {
              "role": { "enum": ["texture", "environment", "metadata", "unknown"] }
            },
            "required": ["role"]
          }
        ]
      }
    },
    "sceneMetadata": {
      "type": "object",
      "required": ["maxVersion", "savedAsVersion", "renderer", "vertices", "faces", "objects"],
      "properties": {
        "maxVersion": { "type": "string" },
        "savedAsVersion": { "type": "string" },
        "renderer": { "type": "string" },
        "vertices": { "type": "integer", "minimum": 1 },
        "faces": { "type": "integer", "minimum": 1 },
        "objects": { "type": "integer", "minimum": 1 },
        "cameras": { "type": "integer", "minimum": 0 }
      }
    },
    "security": {
      "type": "object",
      "required": ["classification", "embeddedScriptedCustomAttributesDetected", "allowScriptExecution", "requiresIsolatedHost", "evidence"],
      "properties": {
        "classification": { "const": "untrusted-active-content" },
        "embeddedScriptedCustomAttributesDetected": { "const": true },
        "allowScriptExecution": { "const": false },
        "requiresIsolatedHost": { "const": true },
        "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    }
  },
  "$defs": {
    "fileRecord": {
      "type": "object",
      "required": ["workspaceRelativePath", "bytes", "sha256"],
      "properties": {
        "workspaceRelativePath": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "additionalProperties": true
}
