{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.china-tower/schemas/conversion-job.schema.json",
  "title": "IsolatedMaxConversionJob",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "assetId",
    "sourceSha256",
    "profileVersion",
    "state",
    "safety",
    "exports",
    "requiredOutputs",
    "steps"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "pattern": "^[a-z]+-[a-f0-9]{12}-v[0-9]+$" },
    "assetId": { "enum": ["yueyang", "huanghe", "tengwang", "feiyun", "penglai"] },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profileVersion": { "const": 1 },
    "state": { "enum": ["awaiting-isolated-conversion", "converting", "converted", "rejected", "blocked"] },
    "safety": {
      "type": "object",
      "required": ["sourceReadOnly", "networkDisabled", "scriptExecutionDisabled", "customAttributesSanitized", "verifiedBy"],
      "properties": {
        "sourceReadOnly": { "type": ["boolean", "null"] },
        "networkDisabled": { "type": ["boolean", "null"] },
        "scriptExecutionDisabled": { "type": ["boolean", "null"] },
        "customAttributesSanitized": { "type": ["boolean", "null"] },
        "verifiedBy": { "type": ["string", "null"] }
      }
    },
    "exports": {
      "type": "object",
      "required": ["analysisProxy", "fullScene"],
      "properties": {
        "analysisProxy": { "$ref": "#/$defs/exportProfile" },
        "fullScene": { "$ref": "#/$defs/exportProfile" }
      }
    },
    "requiredOutputs": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["pending", "done", "skipped", "failed"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "exportProfile": {
      "type": "object",
      "required": ["format", "unit", "preserveHierarchy", "preserveInstances", "includeExecutableContent"],
      "properties": {
        "format": { "const": "FBX" },
        "unit": { "const": "meter" },
        "preserveHierarchy": { "const": true },
        "preserveInstances": { "const": true },
        "includeExecutableContent": { "const": false }
      }
    }
  },
  "additionalProperties": true
}
